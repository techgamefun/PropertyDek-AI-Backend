generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                  String                 @id @default(uuid()) @db.Uuid
  name                String                 @db.VarChar(160)
  slug                String                 @unique @db.VarChar(100)
  countryCode         String?                @map("country_code") @db.Char(2)
  timezone            String?                @db.VarChar(100)
  setupMethod         OnboardingSetupMethod? @map("setup_method")
  onboardingCompleted Boolean                @default(false) @map("onboarding_completed")
  teamStepCompletedAt DateTime?              @map("team_step_completed_at") @db.Timestamptz(6)
  teamStepSkipped     Boolean                @default(false) @map("team_step_skipped")
  demoDataCreatedAt   DateTime?              @map("demo_data_created_at") @db.Timestamptz(6)
  billingEmail        String?                @map("billing_email") @db.VarChar(320)
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  aiAgents            AiAgent[]
  auditLogs           AuditLog[]
  conversations       Conversation[]
  documents           Document[]
  invoices            Invoice[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  memberships         Membership[]
  notifications       Notification[]
  payments            Payment[]
  properties          Property[]
  technicians         Technician[]
  tenants             Tenant[]
  invitations         Invitation[]
  imports             ImportJob[]

  @@map("organizations")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  authProviderId      String?              @unique @map("auth_provider_id") @db.VarChar(255)
  email               String               @unique @db.VarChar(320)
  fullName            String               @map("full_name") @db.VarChar(160)
  passwordHash        String?              @map("password_hash") @db.VarChar(255)
  phone               String?              @db.VarChar(40)
  avatarUrl           String?              @map("avatar_url") @db.VarChar(2048)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs           AuditLog[]
  conversations       Conversation[]
  uploadedDocuments   Document[]           @relation("DocumentUploader")
  authoredComments    MaintenanceComment[]
  memberships         Membership[]
  sentMessages        Message[]
  notifications       Notification[]
  technicians         Technician[]
  sentInvitations     Invitation[]         @relation("InvitationSender")
  acceptedInvitations Invitation[]         @relation("InvitationAccepter")
  createdImports      ImportJob[]
  authSessions        AuthSession[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(VIEWER)
  status         MembershipStatus @default(INVITED)
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(6)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("memberships")
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.VarChar(320)
  role             MembershipRole
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy        User             @relation("InvitationSender", fields: [invitedByUserId], references: [id])
  acceptedBy       User?            @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id])

  @@index([organizationId, status, createdAt])
  @@index([email, status])
  @@map("invitations")
}

model ImportJob {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  createdByUserId String       @map("created_by_user_id") @db.Uuid
  fileName        String       @map("file_name") @db.VarChar(255)
  status          ImportStatus @default(AWAITING_FILE)
  result          Json?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User         @relation(fields: [createdByUserId], references: [id])

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

model Property {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  name                String               @db.VarChar(160)
  type                PropertyType         @default(OTHER)
  status              PropertyStatus       @default(ACTIVE)
  addressLine1        String               @map("address_line1") @db.VarChar(200)
  addressLine2        String?              @map("address_line2") @db.VarChar(200)
  city                String               @db.VarChar(100)
  region              String?              @db.VarChar(100)
  postalCode          String?              @map("postal_code") @db.VarChar(30)
  countryCode         String               @map("country_code") @db.Char(2)
  timezone            String?              @db.VarChar(100)
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents           Document[]
  maintenanceRequests MaintenanceRequest[]
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units               Unit[]

  @@index([organizationId, status])
  @@index([organizationId, city])
  @@map("properties")
}

model Unit {
  id                  String               @id @default(uuid()) @db.Uuid
  propertyId          String               @map("property_id") @db.Uuid
  unitNumber          String               @map("unit_number") @db.VarChar(40)
  floor               Int?
  bedrooms            Decimal?             @db.Decimal(4, 1)
  bathrooms           Decimal?             @db.Decimal(4, 1)
  squareFeet          Int?                 @map("square_feet")
  monthlyRent         Decimal              @map("monthly_rent") @db.Decimal(12, 2)
  status              UnitStatus           @default(AVAILABLE)
  description         String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]
  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, unitNumber])
  @@index([propertyId, status])
  @@map("units")
}

model Tenant {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  fullName            String               @map("full_name") @db.VarChar(160)
  email               String?              @db.VarChar(320)
  phone               String?              @db.VarChar(40)
  avatarUrl           String?               @map("avatar_url") @db.VarChar(2048)
  emergencyContact    String?              @map("emergency_contact") @db.VarChar(160)
  emergencyPhone      String?              @map("emergency_phone") @db.VarChar(40)
  notes               String?
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  leases              Lease[]
  maintenanceComments MaintenanceComment[]
  maintenanceRequests MaintenanceRequest[]
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
  @@index([organizationId, fullName])
  @@map("tenants")
}

model Lease {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  unitId          String       @map("unit_id") @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  status          LeaseStatus  @default(DRAFT)
  startDate       DateTime     @map("start_date") @db.Date
  endDate         DateTime?    @map("end_date") @db.Date
  monthlyRent     Decimal      @map("monthly_rent") @db.Decimal(12, 2)
  securityDeposit Decimal      @default(0) @map("security_deposit") @db.Decimal(12, 2)
  rentDueDay      Int          @default(1) @map("rent_due_day")
  lateFee         Decimal?     @map("late_fee") @db.Decimal(12, 2)
  signedAt        DateTime?    @map("signed_at") @db.Timestamptz(6)
  terminatedAt    DateTime?    @map("terminated_at") @db.Timestamptz(6)
  terms           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents       Document[]
  invoices        Invoice[]
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  unit            Unit         @relation(fields: [unitId], references: [id])
  payments        Payment[]

  @@index([organizationId, status])
  @@index([unitId, status])
  @@index([tenantId, status])
  @@map("leases")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  leaseId        String        @map("lease_id") @db.Uuid
  invoiceNumber  String        @map("invoice_number") @db.VarChar(80)
  description    String?       @db.VarChar(500)
  periodStart    DateTime?     @map("period_start") @db.Date
  periodEnd      DateTime?     @map("period_end") @db.Date
  issuedAt       DateTime?     @map("issued_at") @db.Timestamptz(6)
  dueAt          DateTime      @map("due_at") @db.Timestamptz(6)
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD") @db.Char(3)
  status         InvoiceStatus @default(DRAFT)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  lease          Lease         @relation(fields: [leaseId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payments       Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, dueAt])
  @@index([leaseId, dueAt])
  @@map("invoices")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  leaseId           String        @map("lease_id") @db.Uuid
  invoiceId         String?       @map("invoice_id") @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  method            PaymentMethod @default(OTHER)
  status            PaymentStatus @default(PENDING)
  provider          String?       @db.VarChar(80)
  externalPaymentId String?       @map("external_payment_id") @db.VarChar(255)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  invoice           Invoice?      @relation(fields: [invoiceId], references: [id])
  lease             Lease         @relation(fields: [leaseId], references: [id])
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, externalPaymentId])
  @@index([organizationId, status, paidAt])
  @@index([leaseId, paidAt])
  @@index([invoiceId])
  @@map("payments")
}

model MaintenanceRequest {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  propertyId     String                  @map("property_id") @db.Uuid
  unitId         String?                 @map("unit_id") @db.Uuid
  tenantId       String?                 @map("tenant_id") @db.Uuid
  title          String                  @db.VarChar(200)
  description    String
  category       String?                 @db.VarChar(80)
  priority       MaintenancePriority     @default(MEDIUM)
  status         MaintenanceStatus       @default(OPEN)
  requestedAt    DateTime                @default(now()) @map("requested_at") @db.Timestamptz(6)
  scheduledAt    DateTime?               @map("scheduled_at") @db.Timestamptz(6)
  completedAt    DateTime?               @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  documents      Document[]
  assignments    MaintenanceAssignment[]
  comments       MaintenanceComment[]
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property       Property                @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant         Tenant?                 @relation(fields: [tenantId], references: [id])
  unit           Unit?                   @relation(fields: [unitId], references: [id])

  @@index([organizationId, status, priority])
  @@index([propertyId, requestedAt])
  @@index([tenantId])
  @@map("maintenance_requests")
}

model MaintenanceComment {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @map("maintenance_request_id") @db.Uuid
  authorUserId         String?            @map("author_user_id") @db.Uuid
  authorTenantId       String?            @map("author_tenant_id") @db.Uuid
  body                 String
  isInternal           Boolean            @default(false) @map("is_internal")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  authorTenant         Tenant?            @relation(fields: [authorTenantId], references: [id])
  authorUser           User?              @relation(fields: [authorUserId], references: [id])
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  @@index([maintenanceRequestId, createdAt])
  @@map("maintenance_comments")
}

model Technician {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  userId         String?                 @map("user_id") @db.Uuid
  fullName       String                  @map("full_name") @db.VarChar(160)
  email          String?                 @db.VarChar(320)
  phone          String?                 @db.VarChar(40)
  specialties    String[]                @default([])
  isActive       Boolean                 @default(true) @map("is_active")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments    MaintenanceAssignment[]
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                   @relation(fields: [userId], references: [id])

  @@unique([organizationId, email])
  @@index([userId])
  @@index([organizationId, isActive])
  @@map("technicians")
}

model MaintenanceAssignment {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @map("maintenance_request_id") @db.Uuid
  technicianId         String             @map("technician_id") @db.Uuid
  status               AssignmentStatus   @default(ASSIGNED)
  assignedAt           DateTime           @default(now()) @map("assigned_at") @db.Timestamptz(6)
  completedAt          DateTime?          @map("completed_at") @db.Timestamptz(6)
  notes                String?
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  technician           Technician         @relation(fields: [technicianId], references: [id])

  @@unique([maintenanceRequestId, technicianId])
  @@index([technicianId, status])
  @@map("maintenance_assignments")
}

model Document {
  id                   String              @id @default(uuid()) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  uploadedById         String?             @map("uploaded_by_id") @db.Uuid
  leaseId              String?             @map("lease_id") @db.Uuid
  propertyId           String?             @map("property_id") @db.Uuid
  maintenanceRequestId String?             @map("maintenance_request_id") @db.Uuid
  name                 String              @db.VarChar(255)
  storagePath          String              @map("storage_path") @db.VarChar(2048)
  mimeType             String?             @map("mime_type") @db.VarChar(160)
  sizeBytes            BigInt?             @map("size_bytes")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  lease                Lease?              @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  maintenanceRequest   MaintenanceRequest? @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property             Property?           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedBy           User?               @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([organizationId, createdAt])
  @@index([leaseId])
  @@index([propertyId])
  @@index([maintenanceRequestId])
  @@map("documents")
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  title          String?            @db.VarChar(200)
  status         ConversationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  toolExecutions AiToolExecution[]
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]

  @@index([organizationId, userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String            @id @default(uuid()) @db.Uuid
  conversationId String            @map("conversation_id") @db.Uuid
  userId         String?           @map("user_id") @db.Uuid
  role           MessageRole
  content        String
  metadata       Json?
  inputTokens    Int?              @map("input_tokens")
  outputTokens   Int?              @map("output_tokens")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  toolExecutions AiToolExecution[]
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?             @relation(fields: [userId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model AiAgent {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String?           @map("organization_id") @db.Uuid
  name           String            @db.VarChar(120)
  slug           String            @db.VarChar(100)
  description    String?
  systemPrompt   String            @map("system_prompt")
  model          String            @db.VarChar(120)
  configuration  Json              @default("{}")
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  toolExecutions AiToolExecution[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("ai_agents")
}

model AiToolExecution {
  id             String              @id @default(uuid()) @db.Uuid
  agentId        String?             @map("agent_id") @db.Uuid
  conversationId String?             @map("conversation_id") @db.Uuid
  messageId      String?             @map("message_id") @db.Uuid
  toolName       String              @map("tool_name") @db.VarChar(120)
  input          Json
  output         Json?
  status         ToolExecutionStatus @default(RUNNING)
  error          String?
  startedAt      DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?           @map("finished_at") @db.Timestamptz(6)
  agent          AiAgent?            @relation(fields: [agentId], references: [id])
  conversation   Conversation?       @relation(fields: [conversationId], references: [id])
  message        Message?            @relation(fields: [messageId], references: [id])

  @@index([conversationId, startedAt])
  @@index([agentId, status, startedAt])
  @@map("ai_tool_executions")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  type           NotificationType @default(GENERAL)
  title          String           @db.VarChar(200)
  body           String?
  data           Json?
  readAt         DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(120)
  entityType     String        @map("entity_type") @db.VarChar(120)
  entityId       String?       @map("entity_id") @db.VarChar(255)
  details        Json?
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  actor          User?         @relation(fields: [actorUserId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum MembershipRole {
  OWNER
  ADMIN
  PROPERTY_MANAGER
  ACCOUNTANT
  MAINTENANCE
  VIEWER

  @@map("membership_role")
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("membership_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED

  @@map("invitation_status")
}

enum ImportStatus {
  AWAITING_FILE
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("import_status")
}

enum OnboardingSetupMethod {
  FRESH
  IMPORT
